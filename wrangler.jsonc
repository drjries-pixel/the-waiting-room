{
  // The Waiting Room — a psychiatry practice simulator.
  //
  // ACCOUNT ISOLATION: deploy this into a Cloudflare account dedicated to this
  // project, not one shared with production infrastructure. One login can own
  // several accounts — same login is fine, same account is not.
  // Run `wrangler whoami` and confirm the account before the first deploy.
  "$schema": "node_modules/wrangler/config-schema.json",

  // The deployed URL is <name>.<your-workers.dev-subdomain>.workers.dev, so
  // this name is half the address people read. Keep it short.
  "name": "waitingroom",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Pinned so no wrangler wrapper can silently target a different account.
  // Not a credential — an account ID grants nothing without a scoped token.
  "account_id": "dafe1bb562df74f84598e73eca7c9c5c",

  // Both stated explicitly rather than left to defaults. workers.dev is the
  // one address this app is reachable at; preview URLs would publish an
  // additional public address per deployed version, which is more surface than
  // a single-user app needs.
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waiting-room",
      "database_id": "8d6e2439-9c18-4a1d-aa1b-8a0cddeef691"
    }
  ],

  "vars": {
    // Parent notification for the pause card. Leave empty to disable (default).
    // Set to an HTTPS endpoint to receive a silent, content-free ping.
    "PARENT_ALERT_WEBHOOK": ""
  },

  "observability": { "enabled": true }

  // Secrets (set with `wrangler secret put <NAME>`, never in this file):
  //   ANTHROPIC_API_KEY  - server-side model calls
  //   SESSION_SECRET     - HMAC key for the session cookie (32+ random bytes)
}
